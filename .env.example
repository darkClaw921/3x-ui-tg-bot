BOT_TOKEN=
ADMIN_IDS=123456789,987654321
DB_PATH=./data/bot.db
XUI_BASE_URL=https://panel.example.com:2053
XUI_USERNAME=admin
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_SERVER_HOST=panel.example.com
XUI_SUB_BASE_URL=https://panel.example.com:2096/sub
XUI_VERIFY_SSL=true
LOG_LEVEL=INFO

# --- Локализация (i18n) ---
# Запасной язык интерфейса для новых юзеров, чей language_code неизвестен/не поддержан.
# Один из: ru, en, uk, fa, zh (uk/fa/zh — заглушки с fallback на en).
DEFAULT_LANGUAGE=ru

# --- Кошелёк (баланс в Stars) ---
# CSV сумм для кнопок быстрого пополнения на экране «Кошелёк». Пусто = без пресетов.
WALLET_TOPUP_PRESETS=50,100,250,500

# --- Рост: пробный период и рефералы ---
# Длительность бесплатного пробного периода в днях. 0 = пробный период выключен.
TRIAL_DAYS=3
# Лимит трафика (ГБ) для пробной подписки (totalGB в 3x-ui). 0 = безлимит.
TRIAL_TRAFFIC_GB=10
# Бонус в Stars на баланс пригласившему после первой оплаты приглашённого. 0 = выключено.
REFERRAL_BONUS_STARS=50

# --- Удержание: автопродление и алерты по трафику ---
# Главный выключатель автопродления (нативные Star-подписки + fallback с баланса).
AUTO_RENEW_ENABLED=true
# Порог алерта по трафику (% от квоты тарифа). 0 = выключено. Безлимитные тарифы не алертят.
TRAFFIC_ALERT_PERCENT=80
# Длительность тарифа (дней), дающая право на нативную Telegram Star-подписку (период фикс. 30 дней).
STAR_SUBSCRIPTION_PLAN_DAYS=30

# --- Поддержка ---
# 0 = уведомлять админов из ADMIN_IDS в личку; либо id группы/чата поддержки (обычно отрицательный).
SUPPORT_CHAT_ID=0
